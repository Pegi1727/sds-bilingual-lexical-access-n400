library(geepack)

# Poisson GEE model for L1 Translation Requests
gee_req <- geeglm(
  L1_Req ~ Group * Month,
  id = Participant,
  data = dataset,
  family = poisson(link = "log"),
  corstr = "ar1"
)
summary(gee_req)

# Poisson GEE model for L1 Calques / Syntactic Intrusions
gee_calque <- geeglm(
  L1_Calque ~ Group * Month,
  id = Participant,
  data = dataset,
  family = poisson(link = "log"),
  corstr = "ar1"
)
summary(gee_calque)
